{
  "name": "zapdev-mcp",
  "version": "1.2.0",
  "description": "MCP server for zapdev repository, commit and pull request tools.",
  "type": "module",
  "bin": {
    "zapdev-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mvagnon/zapdev-mcp.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx index.ts",
    "build": "tsc --noEmit false --outDir dist",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "test": "node --import tsx --test index.test.ts",
    "staticchecks": "npm run lint && npm run typecheck && npm run knip && npm run test",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@eslint/json": "2.0.0",
    "@eslint/markdown": "8.0.2",
    "@types/node": "22.20.5",
    "eslint": "10.6.0",
    "knip": "6.41.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1"
  }
}
